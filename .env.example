# ==============================================================================
# DAIH Platform - Environment Variables Template (.env.example)
# ==============================================================================

# Node Environment & Port
NODE_ENV=development
PORT=4000

# Database (PostgreSQL - docker-compose defaults)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/daih_db?schema=public"

# Cache & Message Broker (Redis - docker-compose defaults)
REDIS_URL="redis://localhost:6379"

# Security & Authentication (JWT & Cookies)
# IMPORTANT FOR PRODUCTION: Secrets must be at least 32 characters and independent of each other
JWT_SECRET="super-secret-jwt-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-production-min-32-chars"
TOKEN_ENCRYPTION_KEY="super-secret-encryption-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_REFRESH_DAYS=7
VERIFICATION_EXPIRES_HOURS=24
PASSWORD_RESET_EXPIRES_HOURS=1
COOKIE_DOMAIN=""
COOKIE_SAME_SITE="lax"
QR_SIGNING_SECRET="qr-opaque-signature-key-change-in-production"

# Initial Super Administrator Seeding (used by pnpm run seed:admin)
SUPER_ADMIN_EMAIL="admin@daih.ng"
SUPER_ADMIN_PASSWORD="SuperAdminPassword123!"
SUPER_ADMIN_FIRST_NAME="Super"
SUPER_ADMIN_LAST_NAME="Administrator"
SUPER_ADMIN_PHONE="07042504389"

# Transactional Email (Resend primary, ZeptoMail fallback, mock for local dev)
EMAIL_PROVIDER="auto" # Options: 'auto' | 'resend' | 'zeptomail' | 'mock'
RESEND_API_KEY=""
RESEND_FROM_EMAIL="DAIH Hub <noreply@daih.ng>"
ZEPTOMAIL_API_KEY=""
ZEPTOMAIL_FROM_EMAIL="DAIH Hub <noreply@daih.ng>"
ZEPTOMAIL_API_URL="https://api.zeptomail.com/v1.1/email"

# Rate Limiting (Redis-backed)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=15
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW=60
RATE_LIMIT_VERIFY_MAX=3
RATE_LIMIT_VERIFY_WINDOW=60
RATE_LIMIT_RESET_MAX=3
RATE_LIMIT_RESET_WINDOW=60

# Frontend Base URLs for Email Links & CORS
FRONTEND_CUSTOMER_URL="http://localhost:3001"
FRONTEND_ADMIN_URL="http://localhost:3003"
FRONTEND_WEB_URL="http://localhost:3000"
CLOUDFLARE_TUNNEL_URL=""
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003"

# Public Environment Variables for Frontend Apps (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_CUSTOMER_PWA_URL="http://localhost:3001"
NEXT_PUBLIC_CUSTOMER_PORTAL_URL="http://localhost:3001"
NEXT_PUBLIC_RECEPTION_URL="http://localhost:3002"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3003"

# Payment Gateway (Paystack)
PAYSTACK_SECRET_KEY="sk_test_xxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxx"
PAYSTACK_WEBHOOK_SECRET="wh_sec_xxx"

# File Storage (S3 / MinIO - Optional / Archival)
# NOTE: Active features (PDF audit reports, avatar uploads) operate in-memory / locally.
# No AWS S3 bucket is currently required to run in production.
# If connecting external S3/MinIO in the future for document backups:
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="daih-documents"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"

# Observability (Sentry & Datadog)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
DD_SERVICE="daih-api"
DD_ENV="development"
DD_VERSION="1.0.0"
