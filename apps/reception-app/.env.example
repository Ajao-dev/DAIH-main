# ==============================================================================
# DAIH Reception & Gate Scanner Kiosk - Environment Configuration (.env.example)
# ==============================================================================

# Port (for local development or custom container mapping)
PORT=3002

# Core API Base URL (Must include protocol and /api/v1 prefix)
NEXT_PUBLIC_API_URL="https://api.daih.ng/api/v1"

# Sentry Observability (Optional)
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_APP_ENV="production"
