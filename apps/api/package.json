{
  "name": "@daih/api",
  "version": "1.0.0",
  "private": true,
  "description": "DAIH Workspace Platform - Express Modular Monolith API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "tsx watch src/jobs/worker.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema=src/db/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=src/db/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema=src/db/prisma/schema.prisma",
    "seed:admin": "tsx src/scripts/seed-super-admin.ts"
  },
  "dependencies": {
    "@daih/types": "workspace:*",
    "@prisma/client": "^6.4.1",
    "@sentry/node": "^8.55.0",
    "@sentry/profiling-node": "^8.55.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.41.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dd-trace": "^5.37.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "rate-limit-redis": "^4.2.0",
    "resend": "^4.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@daih/config": "workspace:*",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
