# ==============================================================================
# DAIH Backend API Service - Environment Configuration (.env.example)
# ==============================================================================

# Server & Runtime
NODE_ENV=production
PORT=4000

# PostgreSQL Database Connection
# In production, use your managed PostgreSQL connection string (Supabase, Neon, AWS RDS, etc.)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/daih_db?schema=public"

# Redis Cache & Background Queue Connection (Upstash, Redis Cloud, AWS ElastiCache)
REDIS_URL="redis://localhost:6379"

# Security & Authentication (JWT & Encryption)
# REQUIRED: Must be at least 32 characters and completely independent of each other in production.
JWT_SECRET="super-secret-jwt-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-production-min-32-chars"
TOKEN_ENCRYPTION_KEY="super-secret-encryption-key-change-in-production-min-32-chars"
QR_SIGNING_SECRET="qr-opaque-signature-key-change-in-production"

# Token Expiry Durations
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_REFRESH_DAYS=7
VERIFICATION_EXPIRES_HOURS=24
PASSWORD_RESET_EXPIRES_HOURS=1

# Cookies & Cross-Origin
COOKIE_DOMAIN="" # e.g. ".daih.ng" in production if sharing across subdomains
COOKIE_SAME_SITE="lax" # 'lax' | 'strict' | 'none'
COOKIE_PATH="/api/v1/identity"

# Initial Super Administrator Seeding (used by pnpm run seed:admin)
SUPER_ADMIN_EMAIL="admin@daih.ng"
SUPER_ADMIN_PASSWORD="SuperAdminPassword123!"
SUPER_ADMIN_FIRST_NAME="Super"
SUPER_ADMIN_LAST_NAME="Administrator"
SUPER_ADMIN_PHONE="07042504389"

# Transactional Email Providers
EMAIL_PROVIDER="auto" # Options: 'auto' | 'resend' | 'zeptomail' | 'mock'
RESEND_API_KEY=""
RESEND_FROM_EMAIL="DAIH Hub <noreply@daih.ng>"
ZEPTOMAIL_API_KEY=""
ZEPTOMAIL_FROM_EMAIL="DAIH Hub <noreply@daih.ng>"
ZEPTOMAIL_API_URL="https://api.zeptomail.com/v1.1/email"

# Rate Limiting (Redis-backed)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=15
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW=60
RATE_LIMIT_VERIFY_MAX=3
RATE_LIMIT_VERIFY_WINDOW=60
RATE_LIMIT_RESET_MAX=3
RATE_LIMIT_RESET_WINDOW=60

# Frontend Service URLs (Used for Email Verification/Password Reset links & CORS)
FRONTEND_CUSTOMER_URL="https://app.daih.ng"
FRONTEND_ADMIN_URL="https://admin.daih.ng"
FRONTEND_WEB_URL="https://daih.ng"
ALLOWED_ORIGINS="https://daih.ng,https://app.daih.ng,https://admin.daih.ng,https://reception.daih.ng"

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY="sk_live_xxx"
PAYSTACK_PUBLIC_KEY="pk_live_xxx"
PAYSTACK_WEBHOOK_SECRET="wh_sec_xxx"

# File Storage (Optional S3 / MinIO archiving)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="daih-documents"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"

# Observability (Sentry & Datadog)
SENTRY_DSN=""
DD_SERVICE="daih-api"
DD_ENV="production"
DD_VERSION="1.0.0"
