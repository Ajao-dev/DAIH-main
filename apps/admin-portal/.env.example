# ==============================================================================
# DAIH Staff & Operations Portal - Environment Configuration (.env.example)
# ==============================================================================

# Port (for local development or custom container mapping)
PORT=3003

# Core API Base URL (Must include protocol and /api/v1 prefix)
NEXT_PUBLIC_API_URL="https://api.daih.ng/api/v1"

# Cross-Service Portal Links
NEXT_PUBLIC_ADMIN_URL="https://admin.daih.ng"
NEXT_PUBLIC_CUSTOMER_PWA_URL="https://app.daih.ng"
NEXT_PUBLIC_WEB_URL="https://daih.ng"

# Sentry Observability (Optional)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
NEXT_PUBLIC_APP_ENV="production"
